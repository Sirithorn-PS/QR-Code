# Copy to .env and fill values
# Supabase Pooler connection (Port 6543)
DATABASE_URL=postgresql://user:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Supabase Direct connection (Port 5432)
DIRECT_URL=postgresql://user:password@db.your-supabase-ref.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
JWT_SECRET=your-production-jwt-secret
# Production Vercel domain (comma-separated for multiple):
CORS_ORIGIN=https://your-app.vercel.app
PORT=4000
