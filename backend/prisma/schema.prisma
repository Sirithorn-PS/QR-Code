generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   Int            @id @default(autoincrement())
  username             String         @unique
  password             String
  fullName             String
  employeeId           String?
  role                 String         @default("warehouse_staff")
  status               String         @default("approved")
  createdAt            DateTime       @default(now())
  approvedTransactions Transaction[]  @relation("ApprovedTransactions")
  createdTransactions  Transaction[]  @relation("CreatedTransactions")
  notifications        Notification[]
}

model Product {
  id           Int           @id @default(autoincrement())
  itemCode     String        @unique
  description  String
  unit         String
  warehouse    String
  location     String
  quantity     Float
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  productId    String?
  itemType     String        @default("FG")
  minStock     Float?
  transactions Transaction[]
  lots         ProductLot[]

  @@index([itemCode])
  @@index([itemType])
}

model BillOfMaterial {
  id                Int      @id @default(autoincrement())
  parentItemCode    String
  componentItemCode String
  description       String
  uom               String
  quantity          Float
  warehouse         String
  depth             Int
  bomType           String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([parentItemCode])
  @@index([componentItemCode])
  @@index([parentItemCode, depth])
}

model Transaction {
  id           Int            @id @default(autoincrement())
  productId    Int
  type         String
  quantity     Float
  status       String         @default("pending")
  itemSnapshot Json
  note         String?
  createdById  Int
  approvedById Int?
  createdAt    DateTime       @default(now())
  confirmedAt  DateTime?
  rejectedAt   DateTime?
  approvedBy   User?          @relation("ApprovedTransactions", fields: [approvedById], references: [id])
  createdBy    User           @relation("CreatedTransactions", fields: [createdById], references: [id])
  product      Product        @relation(fields: [productId], references: [id])
  notifications Notification[]
  lot          ProductLot?
  allocations  TransactionLotAllocation[]
}

model ProductLot {
  id                Int          @id @default(autoincrement())
  productId         Int
  lotNumber         String       @unique
  supplierLot       String?
  receivedDate      DateTime
  receivedQuantity  Float
  remainingQuantity Float
  transactionId     Int?         @unique
  status            String       @default("active")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  product           Product      @relation(fields: [productId], references: [id])
  transaction       Transaction? @relation(fields: [transactionId], references: [id])
  allocations       TransactionLotAllocation[]

  @@index([productId, status])
  @@index([receivedDate])
}

model TransactionLotAllocation {
  id           Int        @id @default(autoincrement())
  transactionId Int
  productLotId Int
  quantity     Float
  createdAt    DateTime   @default(now())

  transaction  Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productLot   ProductLot  @relation(fields: [productLotId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([productLotId])
}

model Notification {
  id            Int          @id @default(autoincrement())
  userId        Int?
  targetRole    String?
  type          String       // 'pending_approval' | 'approval_result' | 'low_stock'
  title         String
  message       String
  link          String?
  isRead        Boolean      @default(false)
  transactionId Int?
  createdAt     DateTime     @default(now())

  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([targetRole])
  @@index([isRead])
}

